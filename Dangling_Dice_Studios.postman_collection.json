{
  "info": {
    "name": "Dangling Dice Studios™ API",
    "_postman_id": "dangling-dice-studios-v1",
    "description": "Comprehensive Postman test collection for Dangling Dice Studios™ REST API and MongoDB connection testing. Includes automated tests, JWT token capture, and endpoint verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health & Database Verification",
      "item": [
        {
          "name": "Check API Status & MongoDB Connection",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Confirms Express API server is online and actively connected to the local MongoDB service (dangling_dice_db)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Server status is online', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('online');",
                  "});",
                  "",
                  "pm.test('MongoDB is CONNECTED', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.database).to.be.an('object');",
                  "    pm.expect(json.database.connected).to.be.true;",
                  "    pm.expect(json.database.status).to.eql('connected');",
                  "    pm.expect(json.database.name).to.eql('dangling_dice_db');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Authentication & Creator Portal",
      "item": [
        {
          "name": "Login as Studio Admin (Auto-saves JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"<YOUR_ADMIN_PASSWORD>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates using default seeded admin credentials and automatically saves the returned JWT to {{jwtToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200 OK and JWT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    // Store token in collection variables for subsequent protected calls",
                  "    pm.collectionVariables.set('jwtToken', json.data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current Creator Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            },
            "description": "Validates the Bearer JWT token and retrieves the current creator profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.name).to.include('Dangling Dice Studios');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register New Creator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Producer\",\n  \"email\": \"producer_{{$timestamp}}@danglingdice.com\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new user and hashes password with bcrypt."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 201 Created and JWT', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03. Studio Resources & MongoDB Queries",
      "item": [
        {
          "name": "Get All Resources (Auto-captures itemId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            },
            "description": "Retrieves all studio resources directly from MongoDB and automatically stores the first item ID in {{itemId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Query succeeds with 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "    // Save the first item's ID for subsequent tests",
                  "    pm.collectionVariables.set('itemId', json.data[0]._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: Mobile Apps (Verify AI Calculator & Play Store Link)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?category=Mobile Apps",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                {
                  "key": "category",
                  "value": "Mobile Apps"
                }
              ]
            },
            "description": "Verifies MongoDB category indexing and confirms the AI Calculator app returns with the official Google Play Store URL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mobile Apps returns AI Calculator on Play Store', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "    const app = json.data.find(i => i.title.includes('AI Calculator'));",
                  "    pm.expect(app).to.not.be.undefined;",
                  "    pm.expect(app.mediaUrl).to.include('play.google.com/store/apps/details?id=com.danglingdicestudios.aicalculator');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: Coding Tutorials",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?category=Coding Tutorials",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                {
                  "key": "category",
                  "value": "Coding Tutorials"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns Coding Tutorials from MongoDB', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.every(i => i.category === 'Coding Tutorials')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: Beats & Audio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?category=Beats & Audio",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                {
                  "key": "category",
                  "value": "Beats & Audio"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns Beats & Audio from MongoDB', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.every(i => i.category === 'Beats & Audio')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Single Item by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{itemId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Found single item by MongoDB _id', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data._id).to.eql(pm.collectionVariables.get('itemId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create New Resource (Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Beat — Dark Cyber Trap\",\n  \"description\": \"Automated API test item verifying MongoDB document creation.\",\n  \"category\": \"Beats & Audio\",\n  \"mediaUrl\": \"https://www.youtube.com/@danglingdicestudios\",\n  \"imageUrl\": \"/images/banner.jpg\",\n  \"tags\": [\"Test\", \"Trap\", \"Postman\"],\n  \"price\": 0,\n  \"isFeatured\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resource created successfully in MongoDB', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data._id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04. Security & Negative Authorization Regression",
      "item": [
        {
          "name": "Setup: Register Standard Non-Admin User (Auto-captures userToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Standard Non-Admin User\",\n  \"email\": \"standard_user_{{$timestamp}}@danglingdice.com\",\n  \"password\": \"StandardPass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a test user with the default 'user' role to test privilege escalation boundaries and auto-saves token to {{userToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Non-admin user created with 201 and user role', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.role).to.eql('user');",
                  "    pm.collectionVariables.set('userToken', json.data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "NEG-01: Missing Authorization Header (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            },
            "description": "Validates that protected endpoints immediately reject unauthenticated calls with 401 Unauthorized when Authorization header is absent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects missing Bearer token with 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.include('No Bearer token provided in Authorization header');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "NEG-02: Malformed / Tampered JWT (Expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tampered_payload_data.invalid_signature_hash"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            },
            "description": "Validates that forged, malformed, or tampered JWT signatures fail verification with 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects invalid JWT signature with 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.include('Not authorized');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "NEG-03: Non-Bearer Scheme (Expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic dXNlcjpwYXNzd29yZA=="
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            },
            "description": "Validates that schemes other than Bearer (e.g. Basic auth) are rejected with 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects non-Bearer authorization scheme with 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.include('No Bearer token provided in Authorization header');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "NEG-04: Unauthenticated Resource Creation (Expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Exploit Beat\",\n  \"description\": \"Attempting to create resource without authentication.\",\n  \"category\": \"Beats & Audio\",\n  \"mediaUrl\": \"https://danglingdice.com\",\n  \"imageUrl\": \"/images/banner.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            },
            "description": "Verifies that POST /api/items cannot be accessed anonymously."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Anonymous resource creation rejected with 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "NEG-05: RBAC Privilege Escalation - Non-Admin Item Creation (Expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Non-Admin Exploit Item\",\n  \"description\": \"Should be strictly rejected by admin middleware.\",\n  \"category\": \"Beats & Audio\",\n  \"mediaUrl\": \"https://danglingdice.com\",\n  \"imageUrl\": \"/images/banner.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            },
            "description": "Sends a valid JWT belonging to a user with role 'user'. Asserts that the admin middleware halts execution and returns 403 Forbidden."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects non-admin user with 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.include('Forbidden: Admin access privileges required');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "NEG-06: RBAC Privilege Escalation - Non-Admin Item Deletion (Expect 403)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{itemId}}"]
            },
            "description": "Verifies that a standard authenticated user cannot delete a studio resource owned by admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects non-admin deletion with 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.include('Forbidden: Admin access privileges required');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "NEG-07: Malformed ObjectId / CastError (Expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/invalid-malformed-objectid",
              "host": ["{{baseUrl}}"],
              "path": ["items", "invalid-malformed-objectid"]
            },
            "description": "Verifies that CastError on malformed MongoDB ObjectIDs is gracefully intercepted and returns 404 Not Found without leaking server internals."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed ObjectId returns sanitized 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.include('Resource not found: invalid ID format');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
