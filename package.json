{
  "name": "dangling-dice-studios",
  "version": "1.0.0",
  "private": true,
  "description": "Official Full-Stack Monorepo Platform for Dangling Dice Studios™ — Home to Dangling Beats Studio, Mobile Apps, and Dangling Dice Coding.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/api/server.js",
    "build": "npm run build:web && npm run build:media",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:media": "npm run dev --workspace=apps/media",
    "seed": "npm run seed --workspace=apps/api",
    "test": "npm run test --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:media": "npm run build --workspace=apps/media"
  },
  "keywords": [
    "dangling-dice-studios",
    "dangling-beats",
    "dangling-dice-coding",
    "monorepo",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "rest-api"
  ],
  "author": "Dangling Dice Studios™",
  "homepage": "https://github.com/jacobyancey-bit",
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.25.0",
    "minimatch": "^11.0.1"
  }
}
