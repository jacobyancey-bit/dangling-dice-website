PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dangling_dice_db
JWT_SECRET=your_jwt_secret_key_here

# Client URL (for CORS and Stripe Checkout redirects)
CLIENT_URL=http://localhost:3000

# Stripe Payment & Monetization Credentials
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Media Extraction Gateway (Option A: Bypass YouTube Datacenter BotGuard/PO-Token Block)
# Provider 1: RapidAPI YouTube-to-MP3 (Sign up free on rapidapi.com)
RAPIDAPI_KEY=
RAPIDAPI_HOST=youtube-mp36.p.rapidapi.com

# Provider 2: Self-hosted or dedicated Cobalt API instance
COBALT_API_URL=
COBALT_API_KEY=

# Cloudflare Turnstile Bot Defense (Free CAPTCHA Alternative)
TURNSTILE_SITEKEY=0x4AAAAAAGTLV_EVOrymGKEf
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Railway Redis (Persistent cache & rate-limiting with $0 egress in-memory fallback)
REDIS_PUBLIC_URL=

# Cloudflare R2 Object Storage (10 GB Free Storage, Zero Egress Bandwidth Fees)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dangling-dice-assets
R2_PUBLIC_DOMAIN=

# Discord Webhook Sentinel (Automated 500 Error Alerts & Studio Drops Announcements)
DISCORD_WEBHOOK_URL=

# Staff-only tools (Railway sandbox runner, staff feature flags). Leave blank to disable entirely.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_SECRET=

# Reverse-proxy hop count so req.ip is the real client (rate limits, transcode guard, analytics).
# 1 = Render only; 2 = Cloudflare -> Render with origin locked to Cloudflare. Leave blank for none.
TRUST_PROXY=

# One-time admin bootstrap for `npm run seed` on a blank database (never commit real values)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
