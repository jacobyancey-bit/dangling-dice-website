{
  "openapi": "3.0.3",
  "info": {
    "title": "Dangling Dice Studios™ Cloud API",
    "version": "1.0.0",
    "description": "Official public developer API for Dangling Dice Studios™. Provides high-speed YouTube audio/video extraction, oEmbed 1.0 rich media discovery, studio beat catalog querying, and real-time telemetry.",
    "contact": {
      "name": "Dangling Dice Studios™ Engineering",
      "url": "https://dangling-dice-studios.com/",
      "email": "support@dangling-dice-studios.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://dangling-dice-studios.com/api",
      "description": "Production Central API Gateway"
    },
    {
      "url": "https://media.dangling-dice-studios.com/api",
      "description": "Dedicated Media Subdomain Gateway"
    }
  ],
  "tags": [
    { "name": "Media Converter", "description": "YouTube to MP3 (320kbps) & MP4 media stream extraction" },
    { "name": "Discovery & SEO", "description": "oEmbed 1.0 rich preview generation & crawler endpoints" },
    { "name": "Catalog & Releases", "description": "Dangling Beats instrumentals, coding tutorials, and apps" },
    { "name": "System & Telemetry", "description": "Real-time health diagnostics, database state, and request counters" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System & Telemetry"],
        "summary": "System Health & Live Analytics",
        "description": "Returns operational status, database connectivity, server uptime, and categorized request/crawler counters.",
        "responses": {
          "200": {
            "description": "Service is healthy and fully connected",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/oembed": {
      "get": {
        "tags": ["Discovery & SEO"],
        "summary": "oEmbed 1.0 Rich Preview Provider",
        "description": "Returns compliant oEmbed 1.0 JSON representation used by Discord, Twitter/X, Reddit, and Slack for rich embeds.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "The target URL to generate rich embed metadata for.",
            "schema": { "type": "string", "example": "https://dangling-dice-studios.com/" }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "The requested serialization format (defaults to json).",
            "schema": { "type": "string", "enum": ["json"], "default": "json" }
          }
        ],
        "responses": {
          "200": {
            "description": "Standard oEmbed 1.0 JSON payload",
            "content": {
              "application/json+oembed": {
                "schema": { "$ref": "#/components/schemas/OEmbedResponse" }
              }
            }
          }
        }
      }
    },
    "/media/convert": {
      "post": {
        "tags": ["Media Converter"],
        "summary": "Extract Audio/Video Stream from URL",
        "description": "Validates a public YouTube or audio URL and returns resolved high-speed download streams for MP3 (192kbps/320kbps) or MP4.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "example": "https://www.youtube.com/watch?v=Db7ZrUtuCxU" },
                  "format": { "type": "string", "enum": ["mp3-320", "mp3-192", "mp4"], "default": "mp3-320" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stream metadata and direct download link resolved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MediaConvertResponse" }
              }
            }
          },
          "400": { "description": "Invalid URL or SSRF attempt blocked" }
        }
      }
    },
    "/items": {
      "get": {
        "tags": ["Catalog & Releases"],
        "summary": "List Studio Resources & Beats",
        "description": "Fetches verified studio releases, including Dangling Beats music instrumentals, coding courses, and phone apps.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["All", "Coding Tutorials", "Beats & Audio", "Mobile Apps", "Developer Tools"] }
          }
        ],
        "responses": {
          "200": {
            "description": "List of catalog items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/affiliates": {
      "get": {
        "tags": ["Discovery & SEO"],
        "summary": "Verified Cloud Credits & Partner Deals",
        "description": "Returns verified developer cloud credits (DigitalOcean $200, MongoDB Atlas) and music production perks.",
        "responses": {
          "200": { "description": "Directory of verified developer partner deals" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "healthy" },
          "service": { "type": "string", "example": "Dangling Dice Studios™ Central API" },
          "version": { "type": "string", "example": "1.0.0" },
          "timestamp": { "type": "string", "format": "date-time" },
          "database": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "connected" },
              "connected": { "type": "boolean", "example": true }
            }
          },
          "analytics": {
            "type": "object",
            "properties": {
              "totalRequests": { "type": "integer", "example": 1420 },
              "uptimeSeconds": { "type": "integer", "example": 7200 }
            }
          }
        }
      },
      "OEmbedResponse": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "rich" },
          "version": { "type": "string", "example": "1.0" },
          "title": { "type": "string" },
          "author_name": { "type": "string" },
          "provider_name": { "type": "string" },
          "html": { "type": "string" }
        }
      },
      "MediaConvertResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "title": { "type": "string", "example": "Dance Gavin Dance - Inspire The Liars" },
          "downloadUrl": { "type": "string" },
          "format": { "type": "string", "example": "mp3-320" }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "mediaUrl": { "type": "string" },
          "price": { "type": "number" },
          "isAvailable": { "type": "boolean" }
        }
      }
    }
  }
}

