        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "point",
                  "polygon"
                ],
                "properties": {
                  "point": {
                    "description": "[lng, lat] tuple or {lat, lng} object",
                    "example": [
                      -84.39,
                      33.75
                    ]
                  },
                  "polygon": {
                    "type": "array",
                    "minItems": 3,
                    "items": {},
                    "example": [
                      [
                        -84.4,
                        33.7
                      ],
                      [
                        -84.3,
                        33.7
                      ],
                      [
                        -84.3,
                        33.8
                      ],
                      [
                        -84.4,
                        33.8
                      ]
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Containment result"
          }
        }
      }
